using cast_tag = PriorityTag<1>;

// For reference targets, a direct cast must bind to the source object
// itself -- the target type is an actual layer -- and never materialize a
// temporary through a conversion function or constructor: a reference into
// such a temporary dangles the moment the cast returns.  Value targets are
// unconstrained.
template <typename TargetT, typename U>
struct is_ref_bind_safe
: bool_c<
    not std::is_reference<TargetT>::value ||
    std::is_same<remove_cvref_t<TargetT>, remove_cvref_t<U>>::value ||
    std::is_base_of<remove_cvref_t<TargetT>, remove_cvref_t<U>>::value>
{};

// Trait to check if static_cast<TargetT>(U) is well-formed, and, for
// reference targets, binds directly rather than to a materialized temporary.
template <typename TargetT, typename U, typename = void>
struct is_directly_castable : std::false_type {};

template <typename TargetT, typename U>
struct is_directly_castable<TargetT, U,
    void_t<decltype(static_cast<TargetT>(std::declval<U>()))>>
: is_ref_bind_safe<TargetT, U> {};

// Recursive castability check via struct template specialization.
// GCC evaluates trailing return types of function template overloads eagerly
// during overload resolution -- before checking enable_if default arguments --
// which causes infinite recursion when the trailing return type contains a
// recursive call to cast_impl.  Struct template partial specializations do not
// have this problem: the enable_if in the third parameter is fully resolved
// before the base class (which carries the recursive check) is instantiated.
template <typename TargetT, typename U, typename = void>
struct can_cast_impl;

// True when unwrapping U to reach TargetT would borrow from an expiring
// owner: the source is not an lvalue and borrow_policy holds for the target
// against what one unwrap step yields.  Keyed on borrow_policy directly --
// NOT on probing for a guard overload on U -- so drilling is blocked even for
// types that declare no conversion clause at all.
template <typename TargetT, typename U, typename = void>
struct is_lifetime_guarded_cast : std::false_type {};

template <typename TargetT, typename U>
struct is_lifetime_guarded_cast<TargetT, U,
    void_t<decltype(atlas_value_for(std::declval<U>()))>>
: bool_c<
    not std::is_lvalue_reference<U>::value &&
    borrow_policy<
        TargetT,
        remove_cvref_t<decltype(atlas_value_for(std::declval<U>()))>>::value>
{};

template <typename TargetT, typename U, typename = void>
struct can_cast_via_unwrap : std::false_type {};

// std::conditional (not and_) so the recursive can_cast_impl base is only
// instantiated when the lifetime guard does not already reject the step.
template <typename TargetT, typename U>
struct can_cast_via_unwrap<TargetT, U,
    void_t<decltype(atlas_value_for(std::declval<U>()))>>
: std::conditional<
    is_lifetime_guarded_cast<TargetT, U>::value,
    std::false_type,
    can_cast_impl<TargetT, decltype(atlas_value_for(std::declval<U>()))>
  >::type {};

template <typename TargetT, typename U, typename>
struct can_cast_impl : can_cast_via_unwrap<TargetT, U> {};

// A valid static_cast terminates the search for value targets and for
// directly-bound reference targets; a merely materializing reference cast
// keeps drilling in case an actual layer of the target type lies deeper.
template <typename TargetT, typename U>
struct can_cast_impl<TargetT, U,
    void_t<decltype(static_cast<TargetT>(std::declval<U>()))>>
: std::conditional<
    is_ref_bind_safe<TargetT, U>::value,
    std::true_type,
    can_cast_via_unwrap<TargetT, U>
  >::type {};

// ----------------------------------------------------------------------------
// cast_impl: Drill down to find the first type castable to TargetT
//
// Reference targets reject rvalue sources outright: cast<T const &> or
// cast<T &&> from a temporary would return a reference into a value that
// dies at the end of the full expression.  Bind the source to a named
// variable first.
// ----------------------------------------------------------------------------
template <
    typename TargetT, typename U,
    typename std::enable_if<
        is_ref_bind_safe<TargetT, U>::value &&
        (!std::is_reference<TargetT>::value ||
         std::is_lvalue_reference<U>::value),
        bool>::type = true>
