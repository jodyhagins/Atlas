template <typename T>
using holds_enum = atlas_detail::holds_enum_impl<atlas_detail::remove_cvref_t<T>>;

// Remove exactly one layer, at the type level. SFINAE-friendly: not defined
// when T is neither an atlas type nor an enum.
template <typename T>
using unwrap_t = typename atlas_detail::unwrap_type<T>::type;

// Drill to the root type. Identity for non-atlas, non-enum types.
template <typename T>
using undress_t = typename atlas_detail::undress_type<T>::type;

template <typename T, typename U>
struct is_atlas_of
: atlas_detail::bool_c<
    is_atlas_type<T>::value && std::is_same<undress_t<T>, U>::value>
{ };

template <typename T>
struct is_string_atlas
: is_atlas_of<T, std::string>
{ };

template <typename T>
struct is_arithmetic_atlas
: atlas_detail::bool_c<
    is_atlas_type<T>::value &&
    std::is_arithmetic<undress_t<T>>::value &&
    not std::is_same<undress_t<T>, bool>::value>
{ };

#if defined(__cpp_concepts) && __cpp_concepts >= 201907L
template <typename T>
concept AtlasTypeC = is_atlas_type<T>::value;

template <typename T>
concept HoldsEnumC = holds_enum<T>::value;

// Spelled as conjunctions including AtlasTypeC so that the more specific
// concepts subsume it, and an overload constrained on StringAtlasC beats one
// constrained on AtlasTypeC instead of being ambiguous with it.
template <typename T, typename U>
concept AtlasOfC = AtlasTypeC<T> && std::is_same_v<undress_t<T>, U>;

template <typename T>
concept StringAtlasC = AtlasOfC<T, std::string>;

template <typename T>
concept ArithmeticAtlasC = AtlasTypeC<T> &&
    std::is_arithmetic_v<undress_t<T>> &&
    not std::is_same_v<undress_t<T>, bool>;
#endif

#if defined(__cpp_inline_variables) && __cpp_inline_variables >= 201606L
inline constexpr auto undress = atlas_detail::ToUnderlying{};
#elif defined(__cpp_variable_templates) && __cpp_variable_templates >= 201304L
constexpr auto undress = atlas_detail::ToUnderlying{};
#else
// fallback: not nice, but not terrible and prevents ADL
