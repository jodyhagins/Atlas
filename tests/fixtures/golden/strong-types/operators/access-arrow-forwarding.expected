// This check runs in every generated header, outside the shared guard: when
// a header generated by an older Atlas is included first, its boilerplate
// claims the guard but lacks pieces this header's inline code needs.  Only
// that order is detectable -- a header generated before this check existed
// carries no check text, so including it after a newer header goes
// undiagnosed (harmless while preamble revisions stay additive).  The real
// remedy either way: regenerate every Atlas header with one Atlas version.
#if !defined(WJH_ATLAS_PREAMBLE_VERSION) || WJH_ATLAS_PREAMBLE_VERSION < 2
#error "An Atlas header generated by an older, incompatible Atlas version was included earlier in this translation unit. Regenerate all Atlas headers with the same Atlas version."
#endif

#ifndef WJH_ATLAS_46CE143CD5E7495DAA505B54DBD417A2
#define WJH_ATLAS_46CE143CD5E7495DAA505B54DBD417A2

namespace atlas {
namespace atlas_detail {

struct const_
{
    template <typename T>
    static T const * _ (T * p) { return p; }
    template <typename T>
    static T const & _ (T const & p) { return p; }
};

struct mutable_
{
    template <typename T>
    static T * _ (T * p) { return p; }
    template <typename T>
    static T && _ (T && p) { return static_cast<T&&>(p); }
};

} // namespace atlas_detail
} // namespace atlas

#endif // WJH_ATLAS_46CE143CD5E7495DAA505B54DBD417A2

#ifndef WJH_ATLAS_A527B9864606413FB036AFD74BF8C8BF
#define WJH_ATLAS_A527B9864606413FB036AFD74BF8C8BF

namespace atlas {
namespace atlas_detail {

template <typename T, typename U>
auto
arrow_impl(U & u, PriorityTag<1>)
-> decltype(T::_(u.operator->()))
{
    return T::_(u.operator->());
}

template <typename T, typename U>
auto
arrow_impl(U * u, PriorityTag<1>)
-> decltype(T::_(u))
{
    return T::_(u);
}

template <typename T, typename U>
U * arrow_impl(U & u, PriorityTag<0>)
{
    return std::addressof(u);
}

} // namespace atlas_detail
} // namespace atlas

#endif // WJH_ATLAS_A527B9864606413FB036AFD74BF8C8BF


