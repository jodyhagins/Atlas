cast_impl(U && u, PriorityTag<1>)
-> decltype(static_cast<TargetT>(std::forward<U>(u)))
{
    return static_cast<TargetT>(std::forward<U>(u));
}

// Drill one layer.  Lvalue sources unwrap to references; rvalue sources
// unwrap by value (each layer is moved out), so value targets never hold a
// reference into an expired layer.
template <
    typename TargetT, typename U,
    typename std::enable_if<
        can_cast_impl<TargetT, U>::value &&
        !is_directly_castable<TargetT, U>::value &&
        (!std::is_reference<TargetT>::value ||
         std::is_lvalue_reference<U>::value),
        bool>::type = true>
constexpr TargetT
cast_impl(U && u, PriorityTag<0>)
{
    return cast_impl<TargetT>(atlas_value_for(std::forward<U>(u)), cast_tag{});
}

