template <typename T>
constexpr auto
end_(T && t) noexcept(noexcept(end(std::forward<T>(t))))
-> decltype(end(std::forward<T>(t)))
{
    return end(std::forward<T>(t));
}

// ----------------------------------------------------------------------------
// from_atlas_cast support utilities
// ----------------------------------------------------------------------------

template <typename FromT, typename ToT>
using forward_like_t = typename std::conditional<
    is_lref<FromT>::value,
    ToT const &,
    ToT &&>::type;

// Drill-to probe: true when TargetT is an actual layer of SourceT's atlas
// chain.  The reference target means the layer must genuinely exist -- a type
// that is merely constructible from what SourceT drills down to does not
// qualify.  The probe uses a const lvalue, so the reference-target rvalue
// rejection does not interfere.
template <typename SourceT, typename TargetT, typename = void>
struct is_atlas_castable : std::false_type {};

template <typename SourceT, typename TargetT>
struct is_atlas_castable<SourceT, TargetT,
    void_t<decltype(cast_impl<TargetT const &>(
        std::declval<remove_cvref_t<SourceT> const &>(), cast_tag{}))>>
: std::true_type {};

// Value-category-honest probe of the exact cast the from_atlas_cast
// constructor body performs (always a value target: lvalue chains drill by
// reference and copy at the boundary, rvalue chains move layer by layer), so
// a construction the lifetime guards would reject SFINAEs out instead of
// reporting viable and then hard-erroring.
template <typename ArgT, typename UnderlyingT, typename = void>
struct is_from_cast_constructible : std::false_type {};

template <typename ArgT, typename UnderlyingT>
struct is_from_cast_constructible<ArgT, UnderlyingT,
    void_t<decltype(cast_impl<UnderlyingT>(
        std::declval<ArgT>(), cast_tag{}))>>
: std::true_type {};

} // namespace atlas_detail

using atlas_detail::enable_if_t;
using atlas_detail::remove_cv_t;
using atlas_detail::remove_cvref_t;
using atlas_detail::when;

template <typename T>
using is_atlas_type = atlas_detail::has_atlas_value_type<T>;

template <typename T>
using holds_enum = atlas_detail::holds_enum_impl<atlas_detail::remove_cvref_t<T>>;

// Remove exactly one layer, at the type level. SFINAE-friendly: not defined
// when T is neither an atlas type nor an enum.
template <typename T>
using unwrap_t = typename atlas_detail::unwrap_type<T>::type;

// Drill to the root type. Identity for non-atlas, non-enum types.
template <typename T>
using undress_t = typename atlas_detail::undress_type<T>::type;

template <typename T, typename U>
struct is_atlas_of
: atlas_detail::bool_c<
    is_atlas_type<T>::value && std::is_same<undress_t<T>, U>::value>
{ };

template <typename T>
struct is_string_atlas
: is_atlas_of<T, std::string>
{ };

template <typename T>
struct is_arithmetic_atlas
: atlas_detail::bool_c<
    is_atlas_type<T>::value &&
    std::is_arithmetic<undress_t<T>>::value &&
    not std::is_same<undress_t<T>, bool>::value>
{ };

#if defined(__cpp_concepts) && __cpp_concepts >= 201907L
template <typename T>
concept AtlasTypeC = is_atlas_type<T>::value;

template <typename T>
concept HoldsEnumC = holds_enum<T>::value;

// Spelled as conjunctions including AtlasTypeC so that the more specific
// concepts subsume it, and an overload constrained on StringAtlasC beats one
// constrained on AtlasTypeC instead of being ambiguous with it.
template <typename T, typename U>
concept AtlasOfC = AtlasTypeC<T> && std::is_same_v<undress_t<T>, U>;

template <typename T>
concept StringAtlasC = AtlasOfC<T, std::string>;

template <typename T>
concept ArithmeticAtlasC = AtlasTypeC<T> &&
    std::is_arithmetic_v<undress_t<T>> &&
    not std::is_same_v<undress_t<T>, bool>;
#endif

#if defined(__cpp_inline_variables) && __cpp_inline_variables >= 201606L
inline constexpr auto undress = atlas_detail::ToUnderlying{};
#elif defined(__cpp_variable_templates) && __cpp_variable_templates >= 201304L
constexpr auto undress = atlas_detail::ToUnderlying{};
#else
// fallback: not nice, but not terrible and prevents ADL
namespace {
constexpr atlas_detail::ToUnderlying undress{};
}
#endif

#if defined(__cpp_inline_variables) && __cpp_inline_variables >= 201606L
inline constexpr auto unwrap = atlas_detail::Unwrap{};
#elif defined(__cpp_variable_templates) && __cpp_variable_templates >= 201304L
constexpr auto unwrap = atlas_detail::Unwrap{};
#else
namespace {
constexpr atlas_detail::Unwrap unwrap{};
}
#endif

#if defined(__cpp_inline_variables) && __cpp_inline_variables >= 201606L
inline constexpr auto undress_enum = atlas_detail::UndressEnum{};
#elif defined(__cpp_variable_templates) && __cpp_variable_templates >= 201304L
constexpr auto undress_enum = atlas_detail::UndressEnum{};
#else
namespace {
constexpr atlas_detail::UndressEnum undress_enum{};
}
#endif

#if defined(__cpp_inline_variables) && __cpp_inline_variables >= 201606L
template <typename TargetT>
inline constexpr atlas_detail::CastTo<TargetT> cast{};
#elif defined(__cpp_variable_templates) && __cpp_variable_templates >= 201304L
template <typename TargetT>
constexpr atlas_detail::CastTo<TargetT> cast{};
#else
// fallback: function template (ADL still possible, but unavoidable in C++11)
template <typename TargetT, typename U>
constexpr auto
cast(U && u)
-> decltype(atlas_detail::cast_impl<TargetT>(
    std::forward<U>(u),
    atlas_detail::cast_tag{}))
{
    return atlas_detail::cast_impl<TargetT>(
        std::forward<U>(u),
        atlas_detail::cast_tag{});
}
#endif

} // namespace atlas

#endif // WJH_ATLAS_50E620B544874CB8BE4412EE6773BF90

// This check runs in every generated header, outside the shared guard: when
// a header generated by an older Atlas is included first, its boilerplate
// claims the guard but lacks pieces this header's inline code needs.  Only
// that order is detectable -- a header generated before this check existed
// carries no check text, so including it after a newer header goes
// undiagnosed (harmless while preamble revisions stay additive).  The real
// remedy either way: regenerate every Atlas header with one Atlas version.
#if !defined(WJH_ATLAS_PREAMBLE_VERSION) || WJH_ATLAS_PREAMBLE_VERSION < 2
#error "An Atlas header generated by an older, incompatible Atlas version was included earlier in this translation unit. Regenerate all Atlas headers with the same Atlas version."
#endif

#ifndef WJH_ATLAS_771333B44A11491895F986933BB2FB41
#define WJH_ATLAS_771333B44A11491895F986933BB2FB41
namespace atlas {
namespace atlas_detail {
// ----------------------------------------------------------------------------
// Hash drilling support
// ----------------------------------------------------------------------------

// is_hashable<T>: detects if std::hash<T> is valid
template <typename T, typename = void>
struct is_hashable
: std::false_type
{ };

template <typename T>
struct is_hashable<
    T,
    void_t<decltype(std::hash<T>{}(std::declval<T const &>()))>>
: std::true_type
{ };

// Base case: T is directly hashable
template <typename T>
auto hash_drill(T const & t, PriorityTag<2>)
-> typename std::enable_if<
    is_hashable<T>::value,
    std::size_t>::type
{
    return std::hash<T>{}(t);
}

// Enum fallback: T is an enum without std::hash, use underlying type
template <typename T>
auto hash_drill(T const & t, PriorityTag<1>)
-> typename std::enable_if<
    std::is_enum<T>::value &&
    not is_hashable<T>::value,
    std::size_t>::type
{
    return std::hash<typename std::underlying_type<T>::type>{}(
        static_cast<typename std::underlying_type<T>::type>(t));
}

// Recursive case: T is an atlas type, drill down
template <typename T>
auto hash_drill(T const & t, PriorityTag<0>)
-> decltype(hash_drill(atlas_value_for(t), PriorityTag<2>{}))
{
    return hash_drill(atlas_value_for(t), PriorityTag<2>{});
}
} // namespace atlas_detail
} // namespace atlas
#endif // WJH_ATLAS_771333B44A11491895F986933BB2FB41

#ifndef WJH_ATLAS_83B11BF12B6945019DF71C7517A1D6DA
#define WJH_ATLAS_83B11BF12B6945019DF71C7517A1D6DA
#if __cplusplus >= 202002L
namespace atlas::atlas_detail {

// Concept: T is an atlas type whose underlying value chain is eventually
// hashable
template <typename T>
concept atlas_hashable = has_atlas_value_type<T>::value &&
    requires(T const & t) {
        { hash_drill(atlas_value_for(t), PriorityTag<2>{}) }
            -> std::same_as<std::size_t>;
    };

} // namespace atlas::atlas_detail

template <typename T>
    requires atlas::atlas_detail::atlas_hashable<T>
struct std::hash<T>
{
    std::size_t operator()(T const & t) const
    noexcept(noexcept(atlas::atlas_detail::hash_drill(
        atlas_value_for(t), atlas::atlas_detail::PriorityTag<2>{})))
    {
        return atlas::atlas_detail::hash_drill(
            atlas_value_for(t), atlas::atlas_detail::PriorityTag<2>{});
    }
};
#else // pre-C++20
namespace atlas {
namespace atlas_detail {

// Base class for per-type std::hash specializations.
// The template <typename U = T> trick defers instantiation of the
// return type until operator() is actually called, providing a
// SFINAE-like effect for most cases. Note: this relies on hash_drill
// producing a substitution failure (not a hard error) for non-hashable
// types, which holds for all atlas-generated types.
template <typename T>
struct hash_base
{
    template <typename U = T>
    ATLAS_NODISCARD
    auto operator()(U const & t) const
    noexcept(noexcept(hash_drill(
        atlas_value_for(t), PriorityTag<2>{})))
    -> decltype(hash_drill(
        atlas_value_for(t), PriorityTag<2>{}))
    {
        return hash_drill(
            atlas_value_for(t), PriorityTag<2>{});
    }
};

} // namespace atlas_detail
} // namespace atlas
#endif // C++20
#endif // WJH_ATLAS_83B11BF12B6945019DF71C7517A1D6DA


